CONTENT_FACTORY_ENV=production
AUTH_MODE=google

FRONTEND_URL=https://factory.silverman.pro
BACKEND_URL=https://factory-core.silverman.pro

# Production database runs on Ubuntu host and targets content_factory_prod with scoped application role
DB_PROVIDER=postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=content_factory_prod
POSTGRES_USER=content_factory_app
POSTGRES_PASSWORD=CHANGE_ME

DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

GEMINI_API_KEY=CHANGE_ME

MINIO_ENDPOINT=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=true

GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

GOOGLE_DRIVE_BACKUP_ENABLED=true
GOOGLE_DRIVE_CREDENTIALS_PATH=CHANGE_ME
GOOGLE_DRIVE_ROOT_FOLDER_ID=CHANGE_ME

# Production MUST refuse to start if AUTH_MODE is development-bypass.
